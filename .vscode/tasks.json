{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build debug",
      "type": "shell",
      "command": "cargo build",
      "group": "build",
      "problemMatcher": [
        "$rustc"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "cargo build release",
      "type": "shell",
      "command": "cargo build --release",
      "group": "build",
      "problemMatcher": [
        "$rustc"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
